# Firebase web app config (Project settings → Your apps → Web app). These identify
# the project; they are not secrets. App Check stops other sites using them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# App Check provider: set ONE of these (reCAPTCHA Enterprise preferred).
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_RECAPTCHA_V3_KEY=

# Local development only: "true" prints a debug token in the console to register
# in the Firebase console. Never commit a real debug token.
VITE_APPCHECK_DEBUG=
